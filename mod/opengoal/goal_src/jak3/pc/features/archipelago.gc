;; Jak 3 Archipelago protocol-3 runtime observation and harmless test bridge.
;; Only metadata save wrappers and bridge-owned test state are mutable here.
(in-package goal)

(defconstant AP-PROTOCOL-VERSION 3)
(defconstant AP-GAME-INTEGRATION-VERSION 2)
(defconstant AP-BRIDGE-RUNTIME-VERSION 2)
(defconstant AP-SLOT-DATA-VERSION 2)
(defconstant AP-STATE-SCHEMA-VERSION 1)
(defconstant AP-ITEM-TABLE-VERSION 2)
(defconstant AP-LOCATION-TABLE-VERSION 2)
(defconstant AP-MISSION-TABLE-VERSION 1)
(defconstant AP-MISSION-PROFILE-VERSION 1)

;; Static compatibility metadata only. Milestone 4 does not add gameplay I/O.
(define *ap-design-version* (new 'global 'string 8 "0.3"))
(define *ap-item-table-hash*
  (new 'global 'string 65 "eb557676187512253327e2fdcbad2f8f49f62236d019fdd8129f14cb9987f99c"))
(define *ap-location-table-hash*
  (new 'global 'string 65 "f1c74c5a9da78e8e2b87a57ae283b514038be521699367342c0a555826333793"))
(define *ap-mission-table-hash*
  (new 'global 'string 65 "2e6e631ed650ceb860921e3feb066a85f6d858038a0f46f510a616d17633f09a"))

(defconstant AP-CLIENT-STATUS-STARTING 0)
(defconstant AP-CLIENT-STATUS-AP-DISCONNECTED 1)
(defconstant AP-CLIENT-STATUS-AP-CONNECTED 2)
(defconstant AP-CLIENT-STATUS-STOPPING 3)
(defconstant AP-CLIENT-STATUS-ERROR 4)

(defconstant AP-GAME-STATUS-SOURCE-LOADED 1)
(defconstant AP-GAME-STATUS-READY 2)
(defconstant AP-GAME-STATUS-INCOMPATIBLE 3)
(defconstant AP-GAME-STATUS-CLIENT-DISCONNECTED 4)
(defconstant AP-GAME-STATUS-ERROR 5)

(defconstant AP-COMMAND-NONE 0)
(defconstant AP-COMMAND-HELLO 1)
(defconstant AP-COMMAND-PING 2)
(defconstant AP-COMMAND-QUERY-STATE 3)
(defconstant AP-COMMAND-DISCONNECT 4)
(defconstant AP-COMMAND-SET-TEST-TARGET 100)
(defconstant AP-COMMAND-TEST-ADDITIVE-EFFECT 101)

(defconstant AP-RESULT-NONE 0)
(defconstant AP-RESULT-OK 1)
(defconstant AP-RESULT-PONG 2)
(defconstant AP-RESULT-APPLIED 3)
(defconstant AP-RESULT-ALREADY-APPLIED 4)
(defconstant AP-RESULT-QUEUED 5)
(defconstant AP-RESULT-UNSAFE-NOW 6)
(defconstant AP-RESULT-INCOMPATIBLE 7)
(defconstant AP-RESULT-INVALID-PAYLOAD 8)
(defconstant AP-RESULT-FAILED 9)

(defconstant AP-ERROR-NONE 0)
(defconstant AP-ERROR-PROTOCOL-MISMATCH 1)
(defconstant AP-ERROR-GAME-INTEGRATION-MISMATCH 2)
(defconstant AP-ERROR-STATE-SCHEMA-MISMATCH 3)
(defconstant AP-ERROR-SLOT-DATA-MISMATCH 4)
(defconstant AP-ERROR-ITEM-TABLE-MISMATCH 5)
(defconstant AP-ERROR-LOCATION-TABLE-MISMATCH 6)
(defconstant AP-ERROR-MISSION-TABLE-MISMATCH 7)
(defconstant AP-ERROR-INVALID-CLIENT-SESSION 8)
(defconstant AP-ERROR-INVALID-GAME-SESSION 9)
(defconstant AP-ERROR-OUT-OF-ORDER-COMMAND-ID 10)
(defconstant AP-ERROR-DUPLICATE-COMMAND-CONFLICT 11)
(defconstant AP-ERROR-UNKNOWN-COMMAND 12)
(defconstant AP-ERROR-INVALID-PAYLOAD 13)
(defconstant AP-ERROR-AP-STATE-NOT-LOADED 14)
(defconstant AP-ERROR-AP-STATE-NOT-BOUND 15)
(defconstant AP-ERROR-SAVE-NOT-LOADED 16)
(defconstant AP-ERROR-UNSAFE-GAME-STATE 17)
(defconstant AP-ERROR-ADDITIVE-EFFECT-FORBIDDEN 18)
(defconstant AP-ERROR-INTERNAL-FAILURE 19)

(defconstant AP-SAVE-ELIGIBILITY-UNKNOWN 0)
(defconstant AP-SAVE-ELIGIBILITY-FRESH-UNPROGRESSED 1)
(defconstant AP-SAVE-ELIGIBILITY-INELIGIBLE 2)
(defconstant AP-NATIVE-SAVE-TAG 900)
(defconstant AP-NATIVE-SAVE-TAG-VERSION 1)
(defconstant AP-RECEIPT-LIMIT 8)
(defconstant AP-WIRE-INT32-MIN -2147483648)
(defconstant AP-WIRE-INT32-MAX 2147483647)

(deftype ap-runtime-state (basic)
  ((connection-ready int32)
   (client-heartbeat int32)
   (client-status int32)
   (game-heartbeat int32)
   (game-status int32)
   (save-loaded int32)
   (native-save-slot int32)
   (native-save-eligibility int32)
   (ap-state-loaded int32)
   (ap-state-bound int32)
   (current-level symbol)
   (current-act int32)
   (current-task int32)
   (current-task-node int32)
   (at-title-menu int32)
   (loading int32)
   (in-cutscene int32)
   (dying-or-dead int32)
   (mission-restarting int32)
   (level-transition int32)
   (in-vehicle int32)
   (task-ambiguous int32)
   (safe-permanent int32)
   (safe-consumable int32)
   (safe-mission int32)
   (test-target int32)
   (last-command-id int32)
   (command-high-watermark int32)
   (last-command-kind int32)
   (last-command-result int32)
   (last-error-code int32)
   (snapshot-revision int32)
   (receipt-count int32)
   (receipt-next int32)
   (receipt-id int32 8)
   (receipt-kind int32 8)
   (receipt-payload int32 8)
   (receipt-result int32 8)
   (receipt-error int32 8)))

(define *ap-runtime* (new 'global 'ap-runtime-state))
(define *ap3-client-session* (new 'global 'string 97 "-"))
(define *ap3-session-nonce* (new 'global 'string 97 "-"))
(define *ap3-native-save-identity* (new 'global 'string 97 "-"))
(define *ap3-proposed-save-identity* (new 'global 'string 97 "-"))
(define *ap3-consumed-save-identity* (new 'global 'string 97 "-"))
(define *ap3-error-message* (new 'global 'string 161 "none"))
(define-extern *ap3-native-save-error-code* int)
(define-extern *ap3-native-save-error-message* string)
(define-perm *ap3-native-save-error-code* int AP-ERROR-NONE)
(define-perm *ap3-native-save-error-message* string
  (new 'global 'string 161 "none"))
(define-extern *ap3-activation-generation* int)
(define-perm *ap3-activation-generation* int 0)
(define *ap3-state-path* (new 'global 'string 512 "jak3-ap-state.tmp"))
(define *ap3-log-path* (new 'global 'string 512 (the-as string #f)))
(define *ap3-log-enabled* #f)
(define *ap3-last-client-contact-frame* -1)
(define *ap3-expected-protocol* 0)
(define *ap3-expected-integration* 0)
(define *ap3-expected-state-schema* 0)
(define *ap3-expected-slot-data* 0)
(define *ap3-expected-item-table* 0)
(define *ap3-expected-location-table* 0)
(define *ap3-expected-mission-table* 0)
(define *ap3-expected-item-hash* (new 'global 'string 65 "-"))
(define *ap3-expected-location-hash* (new 'global 'string 65 "-"))
(define *ap3-expected-mission-hash* (new 'global 'string 65 "-"))

;; These globals intentionally survive an (ml) reload. The installer below
;; compares the currently installed hooks with the prior wrapper functions so
;; it can retain the real native implementations across a bridge-only reload,
;; while recapturing them after a full game rebuild replaces the native code.
(define-extern *ap3-native-save-game*
  (function game-info game-save string game-save))
(define-extern *ap3-native-load-game*
  (function game-info game-save game-save))
(define-extern *ap3-native-game-info-initialize*
  (function game-info symbol game-save string resetter-spec game-info))
(define-extern *ap3-installed-save-wrapper*
  (function game-info game-save string game-save))
(define-extern *ap3-installed-load-wrapper*
  (function game-info game-save game-save))
(define-extern *ap3-installed-game-info-initialize-wrapper*
  (function game-info symbol game-save string resetter-spec game-info))
(define-extern *ap3-native-auto-save-done-code* function)
(define-extern *ap3-native-auto-save-error-code* function)
(define-extern *ap3-installed-auto-save-done-code* function)
(define-extern *ap3-installed-auto-save-error-code* function)

;; This descriptor also survives an (ml) reload. The bridge-owned runtime and
;; AP acknowledgement bits are rebuilt on reload, but an already published
;; native identity must remain available to the next native save wrapper.
(define-extern *ap3-reload-save-identity* string)
(define-extern *ap3-reload-save-loaded* int)
(define-extern *ap3-reload-save-slot* int)
(define-extern *ap3-reload-save-eligibility* int)
(define-perm *ap3-reload-save-identity* string
  (new 'global 'string 97 "-"))
(define-perm *ap3-reload-save-loaded* int 0)
(define-perm *ap3-reload-save-slot* int -1)
(define-perm *ap3-reload-save-eligibility* int
  AP-SAVE-ELIGIBILITY-UNKNOWN)

;; Native memory-card I/O continues asynchronously after the save/load method
;; wrapper returns. These candidates must therefore survive an (ml) bridge
;; reload until the matching auto-save done/error behavior resolves them.
(define-extern *ap3-pending-save-identity* string)
(define-extern *ap3-pending-save-valid* int)
(define-extern *ap3-pending-save-succeeded* int)
(define-extern *ap3-pending-save-new-game* int)
(define-extern *ap3-saved-new-game-ready* int)
(define-extern *ap3-pending-save-process* handle)
(define-extern *ap3-pending-save-eligibility* int)
(define-perm *ap3-pending-save-identity* string
  (new 'global 'string 97 "-"))
(define-perm *ap3-pending-save-valid* int 0)
(define-perm *ap3-pending-save-succeeded* int 0)
(define-perm *ap3-pending-save-new-game* int 0)
(define-perm *ap3-saved-new-game-ready* int 0)
(define-perm *ap3-pending-save-process* handle (the-as handle #f))
(define-perm *ap3-pending-save-eligibility* int
  AP-SAVE-ELIGIBILITY-UNKNOWN)

(define-extern ap-export-state! (function none))

(defmacro ap3-log (control &rest args)
  `(begin
     (format #t ,control ,@args)
     (when *ap3-log-enabled*
       (let ((file (new 'stack 'file-stream *ap3-log-path* 'append)))
         (format file ,control ,@args)
         (file-stream-close file)))))

(defun ap3-copy-string! ((destination string) (source string) (limit int))
  (let ((src (-> source data)) (dst (-> destination data)) (count 0))
    (while (and (< count limit) (nonzero? (-> src 0)))
      (set! (-> dst 0) (-> src 0))
      (set! src (&-> src 1))
      (set! dst (&-> dst 1))
      (+! count 1))
    (set! (-> dst 0) (the-as uint 0)))
  0)

(defun ap3-copy-charp! ((destination string) (source (pointer uint8)) (limit int))
  (let ((src source) (dst (-> destination data)) (count 0))
    (while (and (< count limit) (nonzero? (-> src 0)))
      (set! (-> dst 0) (-> src 0))
      (set! src (&-> src 1))
      (set! dst (&-> dst 1))
      (+! count 1))
    (set! (-> dst 0) (the-as uint 0)))
  0)

(defun ap3-set-error! ((code int) (message string))
  (set! (-> *ap-runtime* last-error-code) code)
  (ap3-copy-string! *ap3-error-message* message 160)
  0)

(defun ap3-clear-error! () (ap3-set-error! AP-ERROR-NONE "none"))

(defun ap3-set-native-save-error! ((code int) (message string))
  ;; Native-save diagnostics outlive successful control-plane commands so the
  ;; next exported snapshot cannot silently erase a missing or malformed tag.
  (set! *ap3-native-save-error-code* code)
  (ap3-copy-string! *ap3-native-save-error-message* message 160)
  0)

(defun ap3-clear-native-save-error! ()
  (set! *ap3-native-save-error-code* AP-ERROR-NONE)
  (ap3-copy-string! *ap3-native-save-error-message* "none" 160)
  0)

(defun ap3-valid-client-status? ((status int))
  (and (>= status AP-CLIENT-STATUS-STARTING)
       (<= status AP-CLIENT-STATUS-ERROR)))

(defun ap3-valid-uuid-shape? ((identity string))
  ;; Do not inspect UUID positions until the string is known to contain them.
  ;; The unbound-save path intentionally passes the one-character sentinel "-".
  (if (!= (length identity) 36)
      #f
      (let ((valid #t))
        (dotimes (index 36)
          (let ((character (-> identity data index)))
            (if (or (= index 8) (= index 13) (= index 18) (= index 23))
                (when (!= character (the-as uint 45)) (set! valid #f))
                (when (not (or (and (>= character (the-as uint 48))
                                    (<= character (the-as uint 57)))
                               (and (>= character (the-as uint 97))
                                    (<= character (the-as uint 102)))))
                  (set! valid #f)))))
        valid)))

(defun ap3-clear-reload-save-state! ()
  (ap3-copy-string! *ap3-reload-save-identity* "-" 96)
  (set! *ap3-reload-save-loaded* 0)
  (set! *ap3-reload-save-slot* -1)
  (set! *ap3-reload-save-eligibility* AP-SAVE-ELIGIBILITY-UNKNOWN)
  0)

(defun ap3-save-identity-proposal-usable? ()
  ;; The wrapper may run without another bridge tick, so freshness is checked
  ;; against the real clock at the exact point a native save is serialized.
  (and (nonzero? (-> *ap-runtime* connection-ready))
       (= (-> *ap-runtime* client-status) AP-CLIENT-STATUS-AP-CONNECTED)
       (ap3-valid-uuid-shape? *ap3-proposed-save-identity*)
       (>= *ap3-last-client-contact-frame* 0)
       (< (- (the-as int (-> *display* real-clock frame-counter))
             *ap3-last-client-contact-frame*)
          (seconds 5))))

(defun ap3-game-has-progress? ()
  (let ((progressed (or (!= (-> *game-info* percent-complete) 0.0)
                        (!= (-> *game-info* money-total) 0.0)
                        (!= (-> *game-info* gem-total) 0.0)
                        (!= (-> *game-info* skill-total) 0.0))))
    (dotimes (offset 132)
      (when (task-complete? *game-info* (the-as game-task (+ offset 6)))
        (set! progressed #t)))
    progressed))

(defun ap3-save-fresh-unprogressed? ((save game-save))
  (let ((fresh (and (= (-> save new-game) 1)
                    (= (-> save completion-percentage) 0.0)
                    (= (-> save gem-count) 0.0)
                    (= (-> save skill-count) 0.0)))
        (money-total-seen #f)
        (gem-total-seen #f)
        (skill-total-seen #f)
        (task-list-seen #f)
        (cursor (the-as object (-> save tag)))
        (end (the-as object (&-> save tag 0 user-int8 (-> save length)))))
    ;; Eligibility must describe this serialized save, not whichever game-info
    ;; happened to be active immediately before a restore. Native new-game
    ;; saves contain all four audited tags; absence or malformed task payloads
    ;; fail closed.
    (while (< (the-as int cursor) (the-as int end))
      (let* ((tag (the-as (inline-array game-save-tag) cursor))
             (payload-size (* (the-as int (-> tag 0 elt-size))
                              (-> tag 0 elt-count)))
             (next (+ (the-as int cursor) (logand -16 (+ payload-size 31)))))
        (case (-> tag 0 elt-type)
          (((game-save-elt money-total))
           (set! money-total-seen #t)
           (when (!= (-> tag 0 user-float0) 0.0) (set! fresh #f)))
          (((game-save-elt gem-total))
           (set! gem-total-seen #t)
           (when (!= (-> tag 0 user-float0) 0.0) (set! fresh #f)))
          (((game-save-elt skill-total))
           (set! skill-total-seen #t)
           (when (!= (-> tag 0 user-float0) 0.0) (set! fresh #f)))
          (((game-save-elt task-list))
           (set! task-list-seen #t)
           (if (or (!= (-> tag 0 elt-size) 16)
                   (< (-> tag 0 elt-count) 138))
               (set! fresh #f)
               (dotimes (offset 132)
                 (let ((task-id (+ offset 6)))
                   (when (logtest?
                           (-> (the-as (pointer entity-perm)
                                       (+ (the-as int tag) 16 (* task-id 16)))
                               0 status)
                           (entity-perm-status complete))
                     (set! fresh #f)))))))
        (set! cursor (the-as object next))))
    (and fresh money-total-seen gem-total-seen skill-total-seen
         task-list-seen)))

(defun ap3-clear-pending-native-operation! ()
  (set! *ap3-pending-save-succeeded* 0)
  (set! *ap3-pending-save-new-game* 0)
  (set! *ap3-pending-save-process* (the-as handle #f))
  0)

(defun ap3-invalidate-native-save-binding! ()
  ;; A full game initialization without a game-save starts an unsaved native
  ;; session. It must never inherit the descriptor or sidecar acknowledgement
  ;; from the game that was active before returning to the title menu.
  (set! *ap3-pending-save-valid* 0)
  (set! *ap3-saved-new-game-ready* 0)
  (ap3-clear-pending-native-operation!)
  (ap3-clear-reload-save-state!)
  (ap3-copy-string! *ap3-pending-save-identity* "-" 96)
  (ap3-copy-string! *ap3-native-save-identity* "-" 96)
  (set! (-> *ap-runtime* save-loaded) 0)
  (set! (-> *ap-runtime* native-save-slot) -1)
  (set! (-> *ap-runtime* native-save-eligibility)
        AP-SAVE-ELIGIBILITY-UNKNOWN)
  (set! (-> *ap-runtime* ap-state-loaded) 0)
  (set! (-> *ap-runtime* ap-state-bound) 0)
  (ap3-set-native-save-error!
    AP-ERROR-SAVE-NOT-LOADED "native-save-not-loaded")
  0)

(defun ap3-stage-native-operation! ()
  (set! *ap3-pending-save-succeeded* 0)
  (set! *ap3-pending-save-process* (-> *game-info* auto-save-proc))
  0)

(defun ap3-note-save-eligibility! ((save game-save))
  (set! *ap3-pending-save-eligibility*
        (if (ap3-save-fresh-unprogressed? save)
            AP-SAVE-ELIGIBILITY-FRESH-UNPROGRESSED
            AP-SAVE-ELIGIBILITY-INELIGIBLE))
  ;; Progress is monotonic only for one native identity. A different tagged
  ;; save must retain its own serialized freshness attestation.
  (when (and (= (-> *ap-runtime* native-save-eligibility)
                AP-SAVE-ELIGIBILITY-INELIGIBLE)
             (string= *ap3-pending-save-identity*
                      *ap3-native-save-identity*))
    (set! *ap3-pending-save-eligibility* AP-SAVE-ELIGIBILITY-INELIGIBLE))
  0)

(defun ap3-append-native-save-tag! ((save game-save) (identity string))
  (ap3-clear-pending-native-operation!)
  (set! *ap3-saved-new-game-ready* 0)
  (if (or (not (ap3-valid-uuid-shape? identity))
          (> (+ (-> save length) 64) (-> save allocated-length)))
      (begin
        (set! *ap3-pending-save-valid* 0)
        ;; Native saving remains intact, but an untagged write can no longer
        ;; be treated as the previously bound AP save.
        (ap3-clear-reload-save-state!)
        (ap3-copy-string! *ap3-native-save-identity* "-" 96)
        (set! (-> *ap-runtime* save-loaded) 0)
        (set! (-> *ap-runtime* native-save-slot) -1)
        (set! (-> *ap-runtime* native-save-eligibility)
              AP-SAVE-ELIGIBILITY-UNKNOWN)
        (set! (-> *ap-runtime* ap-state-loaded) 0)
        (set! (-> *ap-runtime* ap-state-bound) 0)
        (ap3-set-native-save-error!
          AP-ERROR-INTERNAL-FAILURE "native-save-tag-append-failed"))
      (let* ((tag-address (+ (the-as int (-> save tag)) (-> save length)))
             (tag (the-as (inline-array game-save-tag) tag-address)))
        (set! (-> tag 0 user-int32 0) AP-NATIVE-SAVE-TAG-VERSION)
        (set! (-> tag 0 user-int32 1) #x4a334150)
        (set! (-> tag 0 elt-count) 37)
        (set! (-> tag 0 elt-size) (the-as uint 1))
        (set! (-> tag 0 elt-type) (the-as game-save-elt AP-NATIVE-SAVE-TAG))
        (copy-charp<-charp (-> tag 1 user-uint8) (-> identity data))
        (+! (-> save length) 64)
        (ap3-copy-string! *ap3-pending-save-identity* identity 96)
        (set! *ap3-pending-save-valid* 1)
        (set! *ap3-pending-save-new-game* (if (= (-> save new-game) 1) 1 0))
        (ap3-note-save-eligibility! save)
        (ap3-stage-native-operation!)))
  0)

(defun ap3-read-native-save-tag! ((save game-save))
  (set! *ap3-pending-save-valid* 0)
  (ap3-clear-pending-native-operation!)
  (set! *ap3-saved-new-game-ready* 0)
  ;; A restore attempt invalidates the reload descriptor immediately. It is
  ;; republished only after the native operation reports successful I/O.
  (ap3-clear-reload-save-state!)
  (ap3-copy-string! *ap3-pending-save-identity* "-" 96)
  (ap3-copy-string! *ap3-native-save-identity* "-" 96)
  (set! (-> *ap-runtime* save-loaded) 0)
  (set! (-> *ap-runtime* native-save-slot) -1)
  (set! (-> *ap-runtime* native-save-eligibility) AP-SAVE-ELIGIBILITY-UNKNOWN)
  (set! (-> *ap-runtime* ap-state-loaded) 0)
  (set! (-> *ap-runtime* ap-state-bound) 0)
  (let ((cursor (the-as object (-> save tag)))
        (end (the-as object (&-> save tag 0 user-int8 (-> save length))))
        (tag-count 0)
        (tag-malformed #f))
    (while (< (the-as int cursor) (the-as int end))
      (let* ((tag (the-as (inline-array game-save-tag) cursor))
             (payload-size (* (the-as int (-> tag 0 elt-size))
                              (-> tag 0 elt-count)))
             (next (+ (the-as int cursor) (logand -16 (+ payload-size 31)))))
        (when (= (the-as int (-> tag 0 elt-type)) AP-NATIVE-SAVE-TAG)
          (+! tag-count 1)
          (if (and (= (-> tag 0 user-int32 0) AP-NATIVE-SAVE-TAG-VERSION)
                   (= (-> tag 0 user-int32 1) #x4a334150)
                   (= (-> tag 0 elt-count) 37)
                   (= (-> tag 0 elt-size) 1)
                   (zero? (-> (the-as (pointer uint8)
                                             (+ (the-as int tag) 16)) 36)))
              (begin
                (ap3-copy-charp! *ap3-pending-save-identity*
                                 (the-as (pointer uint8)
                                         (+ (the-as int tag) 16)) 36)
                (if (ap3-valid-uuid-shape? *ap3-pending-save-identity*)
                    (set! *ap3-pending-save-valid* 1)
                    (set! tag-malformed #t)))
              (set! tag-malformed #t)))
        (set! cursor (the-as object next))))
    (cond
      ((= tag-count 0)
       (ap3-set-native-save-error!
         AP-ERROR-SAVE-NOT-LOADED "native-save-tag-missing"))
      ((> tag-count 1)
       (set! *ap3-pending-save-valid* 0)
       (ap3-set-native-save-error!
         AP-ERROR-INVALID-PAYLOAD "native-save-tag-duplicate"))
      ((or tag-malformed (= *ap3-pending-save-valid* 0))
       (set! *ap3-pending-save-valid* 0)
       (ap3-set-native-save-error!
          AP-ERROR-INVALID-PAYLOAD "native-save-tag-malformed")))
  (ap3-note-save-eligibility! save)
  (when (= *ap3-pending-save-valid* 1) (ap3-stage-native-operation!))
  0))

(defun ap3-save-game-wrapper ((this game-info) (save game-save) (name string))
  (let* ((result (*ap3-native-save-game* this save name))
         (identity
          (if (= (-> result new-game) 1)
              ;; The title-menu New Game path does not restore a save first.
              ;; It must not inherit the identity still published for the
              ;; previously loaded game. Without live authenticated entropy,
              ;; preserve native saving but leave the new save unbound.
              (if (ap3-save-identity-proposal-usable?)
                  *ap3-proposed-save-identity*
                  "-")
              (if (ap3-valid-uuid-shape? *ap3-native-save-identity*)
                  *ap3-native-save-identity*
                  (if (ap3-save-identity-proposal-usable?)
                      *ap3-proposed-save-identity*
                      "-")))))
    (ap3-append-native-save-tag! result identity)
    result))

(defun ap3-load-game-wrapper ((this game-info) (save game-save))
  (ap3-read-native-save-tag! save)
  (*ap3-native-load-game* this save))

(defun ap3-game-info-initialize-wrapper ((this game-info) (mode symbol)
                                         (save game-save) (continue-name string)
                                         (reset-spec resetter-spec))
  ;; Native New Game saves before calling initialize! with no game-save. The
  ;; done hook arms a one-shot marker for that exact transition. Every other
  ;; full no-save initialization, including "Continue Without Save", must
  ;; invalidate the previously published AP descriptor before gameplay starts.
  (when (and (= mode 'game) (not save))
    (if (and (= *ap3-saved-new-game-ready* 1)
             continue-name
             (string= continue-name "intro-start"))
        (set! *ap3-saved-new-game-ready* 0)
        (ap3-invalidate-native-save-binding!)))
  (*ap3-native-game-info-initialize* this mode save continue-name reset-spec))

(defun ap3-pending-operation-matches? ((self auto-save))
  ;; Compare with the bridge-staged handle, not game-info.auto-save-proc.
  ;; Native done clears the latter for save/restore before returning to our
  ;; wrapper, while this staged handle continues to resolve to self until the
  ;; wrapper finishes. Keeping both the pre- and post-dispatch checks rejects
  ;; any staged operation that was invalidated by the native notification.
  (= (handle->process *ap3-pending-save-process*) self))

(defun ap3-publish-pending-native-save! ()
  ;; The native done behavior is the durable I/O boundary. Commit the observed
  ;; descriptor to reload-persistent state there, before another bridge load
  ;; can discard the regular pending-operation globals. The observer calls
  ;; this too as a conservative fallback, but publication does not wait for a
  ;; later heartbeat or for the completed auto-save process to deactivate.
  (when (and (= *ap3-pending-save-valid* 1)
             (= *ap3-pending-save-succeeded* 1)
             (>= (-> *game-info* auto-save-which) 0)
             (< (-> *game-info* auto-save-which) 4)
             (= (-> *game-info* auto-save-status) (mc-status-code ok)))
    ;; Never carry a sidecar acknowledgement from one identity or native slot
    ;; into another. Python must acknowledge this exact descriptor later.
    (when (or (zero? (-> *ap-runtime* save-loaded))
              (not (string= *ap3-pending-save-identity*
                            *ap3-native-save-identity*))
              (!= (-> *ap-runtime* native-save-slot)
                  (-> *game-info* auto-save-which)))
      (set! (-> *ap-runtime* ap-state-loaded) 0)
      (set! (-> *ap-runtime* ap-state-bound) 0))
    (ap3-copy-string! *ap3-native-save-identity* *ap3-pending-save-identity* 96)
    (set! (-> *ap-runtime* native-save-slot) (-> *game-info* auto-save-which))
    (set! (-> *ap-runtime* native-save-eligibility)
          *ap3-pending-save-eligibility*)
    (set! (-> *ap-runtime* save-loaded) 1)
    (ap3-copy-string! *ap3-reload-save-identity*
                      *ap3-native-save-identity* 96)
    (set! *ap3-reload-save-loaded* 1)
    (set! *ap3-reload-save-slot* (-> *ap-runtime* native-save-slot))
    (set! *ap3-reload-save-eligibility*
          (-> *ap-runtime* native-save-eligibility))
    ;; Proposals are one-shot entropy. Once this exact identity is safely
    ;; published, retain an acknowledgement independent of the live save
    ;; descriptor. Python can then rotate even if the save is invalidated or
    ;; switched before its next snapshot.
    (when (string= *ap3-proposed-save-identity*
                   *ap3-native-save-identity*)
      (ap3-copy-string! *ap3-consumed-save-identity*
                        *ap3-native-save-identity* 96)
      (ap3-copy-string! *ap3-proposed-save-identity* "-" 96))
    (set! *ap3-pending-save-valid* 0)
    (ap3-clear-pending-native-operation!)
    (ap3-clear-native-save-error!))
  0)

(defbehavior ap3-auto-save-done-code auto-save ()
  ;; The native done code is the operation-specific success boundary: it runs
  ;; only after mc-save/mc-load completed and updates the authoritative slot.
  (let ((matches (and (= *ap3-pending-save-valid* 1)
                       (ap3-pending-operation-matches? self))))
    ;; Arm this before the native done behavior dispatches its completion
    ;; notification. If that notification starts gameplay immediately, the
    ;; initialize! wrapper can still distinguish a saved New Game from the
    ;; unsaved title-menu path.
    (when (and matches (= *ap3-pending-save-new-game* 1))
      (set! *ap3-saved-new-game-ready* 1))
    (let ((result
            ((the (function object :behavior auto-save)
                   *ap3-native-auto-save-done-code*))))
      (when (and matches
                 (= *ap3-pending-save-valid* 1)
                 (ap3-pending-operation-matches? self))
        (set! *ap3-pending-save-succeeded* 1)
        (ap3-publish-pending-native-save!))
      result)))

(defbehavior ap3-auto-save-error-code auto-save ((status mc-status-code))
  (when (and (= *ap3-pending-save-valid* 1)
             (ap3-pending-operation-matches? self))
    (set! *ap3-pending-save-valid* 0)
    (ap3-clear-pending-native-operation!)
    (ap3-set-native-save-error!
      AP-ERROR-INTERNAL-FAILURE "native-save-io-failed"))
  ((the (function mc-status-code object :behavior auto-save)
        *ap3-native-auto-save-error-code*) status))

(defun ap3-set-contract-versions! ((protocol int) (integration int)
                                   (state-schema int) (slot-data int)
                                   (item-table int) (location-table int)
                                   (mission-table int))
  (set! *ap3-expected-protocol* protocol)
  (set! *ap3-expected-integration* integration)
  (set! *ap3-expected-state-schema* state-schema)
  (set! *ap3-expected-slot-data* slot-data)
  (set! *ap3-expected-item-table* item-table)
  (set! *ap3-expected-location-table* location-table)
  (set! *ap3-expected-mission-table* mission-table)
  0)

(defun ap3-set-contract-hashes! ((item-hash string) (location-hash string)
                                 (mission-hash string))
  ;; Never normalize an overlength value into a valid digest by truncation.
  ;; Each canonical SHA-256 contract value is exactly 64 characters.
  (ap3-copy-string! *ap3-expected-item-hash*
                    (if (= (length item-hash) 64) item-hash "-") 64)
  (ap3-copy-string! *ap3-expected-location-hash*
                    (if (= (length location-hash) 64) location-hash "-") 64)
  (ap3-copy-string! *ap3-expected-mission-hash*
                    (if (= (length mission-hash) 64) mission-hash "-") 64)
  0)

(defun ap3-contract-error ()
  (cond
    ((!= *ap3-expected-protocol* AP-PROTOCOL-VERSION) AP-ERROR-PROTOCOL-MISMATCH)
    ((!= *ap3-expected-integration* AP-GAME-INTEGRATION-VERSION)
     AP-ERROR-GAME-INTEGRATION-MISMATCH)
    ((!= *ap3-expected-state-schema* AP-STATE-SCHEMA-VERSION)
     AP-ERROR-STATE-SCHEMA-MISMATCH)
    ((!= *ap3-expected-slot-data* AP-SLOT-DATA-VERSION) AP-ERROR-SLOT-DATA-MISMATCH)
    ((or (!= *ap3-expected-item-table* AP-ITEM-TABLE-VERSION)
         (not (string= *ap3-expected-item-hash* *ap-item-table-hash*)))
     AP-ERROR-ITEM-TABLE-MISMATCH)
    ((or (!= *ap3-expected-location-table* AP-LOCATION-TABLE-VERSION)
         (not (string= *ap3-expected-location-hash* *ap-location-table-hash*)))
     AP-ERROR-LOCATION-TABLE-MISMATCH)
    ((or (!= *ap3-expected-mission-table* AP-MISSION-TABLE-VERSION)
         (not (string= *ap3-expected-mission-hash* *ap-mission-table-hash*)))
     AP-ERROR-MISSION-TABLE-MISMATCH)
    (else AP-ERROR-NONE)))

(defun ap3-observe-task! ()
  (set! (-> *ap-runtime* current-level) (the-as symbol #f))
  (set! (-> *ap-runtime* current-task) -1)
  (set! (-> *ap-runtime* current-task-node) -1)
  (set! (-> *ap-runtime* current-act) 0)
  (set! (-> *ap-runtime* task-ambiguous) 0)
  (let ((active-count 0) (selected (the-as game-task-node-info #f)))
    (dotimes (index (-> *game-info* sub-task-list length))
      (let ((node (-> *game-info* sub-task-list index)))
        (when (and (-> node manager)
                   (handle->process (-> node manager manager)))
          (+! active-count 1)
          (set! selected node)
          (set! (-> *ap-runtime* current-task-node) index))))
    (cond
      ((> active-count 1)
       (set! (-> *ap-runtime* task-ambiguous) 1)
       (set! (-> *ap-runtime* current-task-node) -1))
      ((= active-count 1)
       (set! (-> *ap-runtime* current-level) (-> selected level))
       (set! (-> *ap-runtime* current-task) (the-as int (-> selected task)))
       (cond
         ((logtest? (-> selected flags) (game-task-node-flag act1))
          (set! (-> *ap-runtime* current-act) 1))
         ((logtest? (-> selected flags) (game-task-node-flag act2))
          (set! (-> *ap-runtime* current-act) 2))
         ((logtest? (-> selected flags) (game-task-node-flag act3))
          (set! (-> *ap-runtime* current-act) 3)))))
    active-count))

(defun ap3-observe-runtime! ()
  (let* ((level (level-get-target-inside *level*))
         (active-missions (ap3-observe-task!))
         (title (and (-> *game-info* current-continue)
                     (logtest? (-> *game-info* current-continue flags)
                               (continue-flags title title-movie))))
         (loading (load-in-progress? *level*))
         (cutscene (movie?))
         (dead (or (<= (-> *game-info* life) 0.0)
                   (and *target*
                        (logtest? (-> *target* focus-status)
                                  (focus-status dead)))))
         (restarting (get-resetter *resetter-control*))
         (transition (or loading
                         (and *target*
                              (logtest? (-> *target* focus-status)
                                        (focus-status teleporting)))))
         (vehicle (and *target*
                       (logtest? (-> *target* focus-status)
                                 (focus-status pilot pilot-riding mech tube flut
                                               board rail halfpipe indax in-head turret
                                               dark light))))
         (stable #f))
    (when level (set! (-> *ap-runtime* current-level) (-> level name)))
    (set! (-> *ap-runtime* at-title-menu) (if title 1 0))
    (set! (-> *ap-runtime* loading) (if loading 1 0))
    (set! (-> *ap-runtime* in-cutscene) (if cutscene 1 0))
    (set! (-> *ap-runtime* dying-or-dead) (if dead 1 0))
    (set! (-> *ap-runtime* mission-restarting) (if restarting 1 0))
    (set! (-> *ap-runtime* level-transition) (if transition 1 0))
    (set! (-> *ap-runtime* in-vehicle) (if vehicle 1 0))
    ;; Successful operations normally publish in their done hook. Retain this
    ;; fallback so observation also commits any compatible staged success.
    (ap3-publish-pending-native-save!)
    ;; Eligibility is deliberately monotonic for the currently observed save.
    (when (and (= (-> *ap-runtime* native-save-eligibility)
                  AP-SAVE-ELIGIBILITY-FRESH-UNPROGRESSED)
               (ap3-game-has-progress?))
      (set! (-> *ap-runtime* native-save-eligibility)
            AP-SAVE-ELIGIBILITY-INELIGIBLE)
      (set! *ap3-reload-save-eligibility* AP-SAVE-ELIGIBILITY-INELIGIBLE))
    (set! stable
          (and (nonzero? (-> *ap-runtime* connection-ready))
               (nonzero? (-> *ap-runtime* save-loaded))
               (nonzero? (-> *ap-runtime* ap-state-loaded))
               (nonzero? (-> *ap-runtime* ap-state-bound))
               (not (not *target*)) (not (not level))
               (not title) (not loading) (not cutscene) (not dead)
               (not restarting) (not transition) (not vehicle)
               (zero? (-> *ap-runtime* task-ambiguous))))
    (set! (-> *ap-runtime* safe-permanent) (if stable 1 0))
    (set! (-> *ap-runtime* safe-consumable) 0)
    (set! (-> *ap-runtime* safe-mission)
          (if (and stable (= active-missions 0)) 1 0)))
  0)

(defun ap-export-state! ()
  (ap3-observe-runtime!)
  (+! (-> *ap-runtime* snapshot-revision) 1)
  (let ((file (new 'stack 'file-stream *ap3-state-path* 'write))
        (revision (-> *ap-runtime* snapshot-revision)))
    (format file "snapshot_begin ~D~%" revision)
    (format file "protocol_version ~D~%" AP-PROTOCOL-VERSION)
    (format file "game_integration_version ~D~%" AP-GAME-INTEGRATION-VERSION)
    (format file "bridge_runtime_version ~D~%" AP-BRIDGE-RUNTIME-VERSION)
    (format file "bridge_activation_generation ~D~%"
            *ap3-activation-generation*)
    (format file "state_schema_version ~D~%" AP-STATE-SCHEMA-VERSION)
    (format file "slot_data_version ~D~%" AP-SLOT-DATA-VERSION)
    (format file "item_table_version ~D~%" AP-ITEM-TABLE-VERSION)
    (format file "location_table_version ~D~%" AP-LOCATION-TABLE-VERSION)
    (format file "mission_table_version ~D~%" AP-MISSION-TABLE-VERSION)
    (format file "item_table_hash ~S~%" *ap-item-table-hash*)
    (format file "location_table_hash ~S~%" *ap-location-table-hash*)
    (format file "mission_table_hash ~S~%" *ap-mission-table-hash*)
    (format file "connection_ready ~D~%" (-> *ap-runtime* connection-ready))
    (format file "client_session_id ~S~%" *ap3-client-session*)
    (format file "session_nonce ~S~%" *ap3-session-nonce*)
    (format file "client_heartbeat ~D~%" (-> *ap-runtime* client-heartbeat))
    (format file "client_status ~D~%" (-> *ap-runtime* client-status))
    (format file "game_heartbeat ~D~%" (-> *ap-runtime* game-heartbeat))
    (format file "game_status ~D~%" (-> *ap-runtime* game-status))
    (format file "game_running 1~%source_loaded 1~%")
    (format file "save_loaded ~D~%" (-> *ap-runtime* save-loaded))
    (format file "native_save_slot ~D~%" (-> *ap-runtime* native-save-slot))
    (format file "native_save_identity ~S~%" *ap3-native-save-identity*)
    (format file "consumed_save_identity ~S~%" *ap3-consumed-save-identity*)
    (format file "native_save_eligibility ~D~%"
            (-> *ap-runtime* native-save-eligibility))
    (format file "ap_state_loaded ~D~%" (-> *ap-runtime* ap-state-loaded))
    (format file "ap_state_bound ~D~%" (-> *ap-runtime* ap-state-bound))
    (if (-> *ap-runtime* current-level)
        (format file "current_level ~A~%" (-> *ap-runtime* current-level))
        (format file "current_level -~%"))
    (format file "current_act ~D~%" (-> *ap-runtime* current-act))
    (format file "current_task ~D~%" (-> *ap-runtime* current-task))
    (format file "current_task_node ~D~%" (-> *ap-runtime* current-task-node))
    (format file "at_title_menu ~D~%" (-> *ap-runtime* at-title-menu))
    (format file "loading ~D~%" (-> *ap-runtime* loading))
    (format file "in_cutscene ~D~%" (-> *ap-runtime* in-cutscene))
    (format file "dying_or_dead ~D~%" (-> *ap-runtime* dying-or-dead))
    (format file "mission_restarting ~D~%" (-> *ap-runtime* mission-restarting))
    (format file "level_transition ~D~%" (-> *ap-runtime* level-transition))
    (format file "in_vehicle ~D~%" (-> *ap-runtime* in-vehicle))
    (format file "safe_to_apply_permanent_item ~D~%"
            (-> *ap-runtime* safe-permanent))
    (format file "safe_to_apply_consumable ~D~%" (-> *ap-runtime* safe-consumable))
    (format file "safe_to_mutate_mission_state ~D~%" (-> *ap-runtime* safe-mission))
    (format file "test_target ~D~%" (-> *ap-runtime* test-target))
    (format file "last_command_id ~D~%" (-> *ap-runtime* last-command-id))
    (format file "last_command_kind ~D~%" (-> *ap-runtime* last-command-kind))
    (format file "last_command_result ~D~%" (-> *ap-runtime* last-command-result))
    (if (nonzero? (-> *ap-runtime* last-error-code))
        (begin
          (format file "last_error_code ~D~%" (-> *ap-runtime* last-error-code))
          (format file "last_error_message ~S~%" *ap3-error-message*))
        (begin
          (format file "last_error_code ~D~%" *ap3-native-save-error-code*)
          (format file "last_error_message ~S~%" *ap3-native-save-error-message*)))
    (format file "recent_command_count ~D~%" (-> *ap-runtime* receipt-count))
    (dotimes (index (-> *ap-runtime* receipt-count))
      (format file "recent_command_~D_id ~D~%" index
              (-> *ap-runtime* receipt-id index))
      (format file "recent_command_~D_kind ~D~%" index
              (-> *ap-runtime* receipt-kind index))
      (format file "recent_command_~D_payload ~D~%" index
              (-> *ap-runtime* receipt-payload index))
      (format file "recent_command_~D_result ~D~%" index
              (-> *ap-runtime* receipt-result index))
      (format file "recent_command_~D_error ~D~%" index
              (-> *ap-runtime* receipt-error index)))
    (format file "snapshot_end ~D~%" revision)
    (file-stream-close file))
  (none))

(defun ap-set-state-path! ((source string))
  (ap3-copy-string! *ap3-state-path* source 511)
  (ap-export-state!)
  0)

(defun ap-set-log-path! ((source string))
  (ap3-copy-string! *ap3-log-path* source 511)
  (set! *ap3-log-enabled* #t)
  (ap3-log "[JAK3-AP] log configured protocol=~D integration=~D~%"
           AP-PROTOCOL-VERSION AP-GAME-INTEGRATION-VERSION)
  0)

(defun ap3-apply-sidecar-state! ((state-flags int) (state-save-slot int)
                                 (state-save-identity string))
  ;; Loaded/bound are acknowledgements for one exact native descriptor, never
  ;; transferable authority. A save switch may complete between heartbeats,
  ;; so stale bits must fail closed instead of re-binding the new live save.
  (let ((state-loaded (logtest? state-flags 1))
        (state-bound (logtest? state-flags 2))
        (matches (and (= (logand state-flags -4) 0)
                      (nonzero? (-> *ap-runtime* save-loaded))
                      (= state-save-slot (-> *ap-runtime* native-save-slot))
                      (ap3-valid-uuid-shape? state-save-identity)
                      (string= state-save-identity *ap3-native-save-identity*))))
    (set! (-> *ap-runtime* ap-state-loaded)
          (if (and matches state-loaded) 1 0))
    (set! (-> *ap-runtime* ap-state-bound)
          (if (and matches state-loaded state-bound) 1 0)))
  0)

(defun ap3-update-client-state! ((client-status int) (state-flags int)
                                 (state-save-slot int)
                                 (state-save-identity string))
  (set! (-> *ap-runtime* client-status) client-status)
  (ap3-apply-sidecar-state! state-flags state-save-slot state-save-identity)
  (if (= client-status AP-CLIENT-STATUS-AP-CONNECTED)
      (set! *ap3-last-client-contact-frame*
            (the-as int (-> *display* real-clock frame-counter)))
      (begin
        (set! *ap3-last-client-contact-frame* -1)
        (ap3-copy-string! *ap3-proposed-save-identity* "-" 96)))
  0)

(defun ap3-update-proposed-save-identity! ((proposed-save string)
                                            (client-status int))
  ;; A client may arm identity creation only after authenticated slot data is
  ;; known. A heartbeat can carry the just-consumed proposal once more before
  ;; Python observes its publication, so never re-arm either the live identity
  ;; or the game-owned consumption acknowledgement. Disconnected/invalid/stale
  ;; proposals actively clear old entropy.
  (if (and (= client-status AP-CLIENT-STATUS-AP-CONNECTED)
           (ap3-valid-uuid-shape? proposed-save)
           (not (string= proposed-save *ap3-native-save-identity*))
           (not (string= proposed-save *ap3-consumed-save-identity*)))
      (ap3-copy-string! *ap3-proposed-save-identity* proposed-save 96)
      (ap3-copy-string! *ap3-proposed-save-identity* "-" 96))
  0)

(defmacro ap-client-hello! (protocol integration state-schema slot-data
                            item-table location-table mission-table item-hash
                            location-hash mission-hash client-session proposed-session
                            proposed-save client-status state-flags
                            state-save-slot state-save-identity)
  `(begin
     (ap3-set-contract-versions! ,protocol ,integration ,state-schema ,slot-data
                                 ,item-table ,location-table ,mission-table)
     (ap3-set-contract-hashes! ,item-hash ,location-hash ,mission-hash)
     (ap3-client-hello-core! ,client-session ,proposed-session ,proposed-save
                             ,client-status ,state-flags
                             ,state-save-slot ,state-save-identity)))

(defun ap3-client-hello-core! ((client-session string) (proposed-session string)
                               (proposed-save string) (client-status int)
                               (state-flags int)
                               (state-save-slot int) (state-save-identity string))
  (set! (-> *ap-runtime* last-command-id) -1)
  (set! (-> *ap-runtime* last-command-kind) AP-COMMAND-HELLO)
  (let ((error (ap3-contract-error)))
    (cond
      ((nonzero? error)
       (set! (-> *ap-runtime* connection-ready) 0)
       (set! (-> *ap-runtime* game-status) AP-GAME-STATUS-INCOMPATIBLE)
       (set! (-> *ap-runtime* last-command-result) AP-RESULT-INCOMPATIBLE)
       (ap3-set-error! error "compatibility-mismatch"))
      ((not (ap3-valid-client-status? client-status))
       (set! (-> *ap-runtime* connection-ready) 0)
       (set! (-> *ap-runtime* game-status) AP-GAME-STATUS-ERROR)
       (set! (-> *ap-runtime* last-command-result) AP-RESULT-INVALID-PAYLOAD)
       (ap3-set-error! AP-ERROR-INVALID-PAYLOAD "invalid-client-status"))
      (else
       (ap3-copy-string! *ap3-client-session* client-session 96)
       ;; The first authenticated hello supplies entropy. Later client
       ;; reconnects retain this game-owned nonce and the receipt ring.
       (when (string= *ap3-session-nonce* "-")
         (ap3-copy-string! *ap3-session-nonce* proposed-session 96))
       (ap3-update-proposed-save-identity! proposed-save client-status)
       (set! (-> *ap-runtime* client-heartbeat) -1)
       (set! (-> *ap-runtime* game-heartbeat) 0)
       (ap3-update-client-state! client-status state-flags
                                 state-save-slot state-save-identity)
       (set! (-> *ap-runtime* connection-ready) 1)
       (set! (-> *ap-runtime* game-status) AP-GAME-STATUS-READY)
       (set! (-> *ap-runtime* last-command-result) AP-RESULT-OK)
       (ap3-clear-error!))))
  (ap-export-state!)
  0)

(defun ap-ping! ((client-session string) (game-session string) (sequence int)
                 (client-status int) (state-flags int)
                 (state-save-slot int) (state-save-identity string)
                 (proposed-save string))
  (set! (-> *ap-runtime* last-command-id) -1)
  (set! (-> *ap-runtime* last-command-kind) AP-COMMAND-PING)
  (cond
    ((or (zero? (-> *ap-runtime* connection-ready))
         (not (string= client-session *ap3-client-session*)))
     (set! (-> *ap-runtime* last-command-result) AP-RESULT-FAILED)
     (ap3-set-error! AP-ERROR-INVALID-CLIENT-SESSION "invalid-client-session"))
    ((not (string= game-session *ap3-session-nonce*))
     (set! (-> *ap-runtime* last-command-result) AP-RESULT-FAILED)
     (ap3-set-error! AP-ERROR-INVALID-GAME-SESSION "invalid-game-session"))
    ((or (not (ap3-valid-client-status? client-status))
         (< sequence (-> *ap-runtime* client-heartbeat)))
     (set! (-> *ap-runtime* last-command-result) AP-RESULT-INVALID-PAYLOAD)
     (ap3-set-error! AP-ERROR-INVALID-PAYLOAD "invalid-ping"))
    (else
     (when (> sequence (-> *ap-runtime* client-heartbeat))
       (set! (-> *ap-runtime* client-heartbeat) sequence)
       (set! (-> *ap-runtime* game-heartbeat) (+ sequence 1)))
     (ap3-update-proposed-save-identity! proposed-save client-status)
     (ap3-update-client-state! client-status state-flags
                               state-save-slot state-save-identity)
     (set! (-> *ap-runtime* last-command-result) AP-RESULT-PONG)
     (ap3-clear-error!)))
  (ap-export-state!)
  0)

(defun ap-query-state! ((client-session string) (game-session string)
                        (client-status int) (state-flags int)
                        (state-save-slot int) (state-save-identity string))
  (set! (-> *ap-runtime* last-command-id) -1)
  (set! (-> *ap-runtime* last-command-kind) AP-COMMAND-QUERY-STATE)
  (cond
    ((or (zero? (-> *ap-runtime* connection-ready))
         (not (string= client-session *ap3-client-session*)))
     (set! (-> *ap-runtime* last-command-result) AP-RESULT-FAILED)
     (ap3-set-error! AP-ERROR-INVALID-CLIENT-SESSION "invalid-client-session"))
    ((not (string= game-session *ap3-session-nonce*))
     (set! (-> *ap-runtime* last-command-result) AP-RESULT-FAILED)
     (ap3-set-error! AP-ERROR-INVALID-GAME-SESSION "invalid-game-session"))
    ((not (ap3-valid-client-status? client-status))
     (set! (-> *ap-runtime* last-command-result) AP-RESULT-INVALID-PAYLOAD)
     (ap3-set-error! AP-ERROR-INVALID-PAYLOAD "invalid-query"))
    (else
     (ap3-update-client-state! client-status state-flags
                               state-save-slot state-save-identity)
     (set! (-> *ap-runtime* last-command-result) AP-RESULT-OK)
     (ap3-clear-error!)))
  (ap-export-state!)
  0)

(defun ap3-find-receipt ((command-id int))
  (let ((found -1))
    (dotimes (index (-> *ap-runtime* receipt-count))
      (when (= (-> *ap-runtime* receipt-id index) command-id)
        (set! found index)))
    found))

(defun ap3-wire-int32? ((value int))
  (and (>= value AP-WIRE-INT32-MIN)
       (<= value AP-WIRE-INT32-MAX)))

(defun ap3-record-receipt! ((command-id int) (kind int) (payload int)
                            (result int) (error int))
  (let ((index (-> *ap-runtime* receipt-next)))
    (set! (-> *ap-runtime* receipt-id index) command-id)
    (set! (-> *ap-runtime* receipt-kind index) kind)
    (set! (-> *ap-runtime* receipt-payload index) payload)
    (set! (-> *ap-runtime* receipt-result index) result)
    (set! (-> *ap-runtime* receipt-error index) error)
    (set! (-> *ap-runtime* receipt-next) (mod (+ index 1) AP-RECEIPT-LIMIT))
    (when (< (-> *ap-runtime* receipt-count) AP-RECEIPT-LIMIT)
      (+! (-> *ap-runtime* receipt-count) 1)))
  (set! (-> *ap-runtime* command-high-watermark) command-id)
  0)

(defmacro ap-command! (client-session game-session command-id kind payload
                       state-flags state-save-slot state-save-identity
                       protocol integration state-schema slot-data item-table
                       location-table mission-table item-hash location-hash mission-hash)
  `(begin
     (ap3-set-contract-versions! ,protocol ,integration ,state-schema ,slot-data
                                 ,item-table ,location-table ,mission-table)
     (ap3-set-contract-hashes! ,item-hash ,location-hash ,mission-hash)
     (ap3-command-core! ,client-session ,game-session ,command-id ,kind ,payload
                        ,state-flags ,state-save-slot ,state-save-identity)))

(defun ap3-command-core! ((client-session string) (game-session string)
                          (command-id int) (kind int) (payload int)
                          (state-flags int)
                          (state-save-slot int) (state-save-identity string))
  (let* ((wire-command-id (ap3-wire-int32? command-id))
         (wire-kind (ap3-wire-int32? kind))
         (wire-payload (ap3-wire-int32? payload))
         (contract-error (ap3-contract-error))
         (receipt-index (if wire-command-id
                            (ap3-find-receipt command-id)
                            -1))
         (result AP-RESULT-FAILED)
         (error AP-ERROR-NONE)
         (message "failed"))
    ;; Reject values that cannot be represented by the int32 snapshot and
    ;; receipt fields before publishing, deduplicating, or applying them.
    (set! (-> *ap-runtime* last-command-id)
          (if wire-command-id command-id -1))
    (set! (-> *ap-runtime* last-command-kind)
          (if wire-kind kind AP-COMMAND-NONE))
    ;; Heartbeat snapshots are observations, not mutation leases. Refresh the
    ;; authenticated client's exact-descriptor acknowledgement and every
    ;; runtime/save guard at command time before consulting safe-permanent.
    (when (and (zero? contract-error)
               wire-command-id
               wire-kind
               wire-payload
               (nonzero? (-> *ap-runtime* connection-ready))
               (string= client-session *ap3-client-session*)
               (string= game-session *ap3-session-nonce*))
      (ap3-apply-sidecar-state! state-flags state-save-slot state-save-identity))
    (ap3-observe-runtime!)
    (cond
      ((nonzero? contract-error)
       (set! result AP-RESULT-INCOMPATIBLE)
       (set! error contract-error)
       (set! message "compatibility-mismatch"))
      ((not (string= client-session *ap3-client-session*))
       (set! error AP-ERROR-INVALID-CLIENT-SESSION)
       (set! message "invalid-client-session"))
      ((not (string= game-session *ap3-session-nonce*))
       (set! error AP-ERROR-INVALID-GAME-SESSION)
       (set! message "invalid-game-session"))
      ((or (not wire-command-id) (not wire-kind) (not wire-payload))
       (set! result AP-RESULT-INVALID-PAYLOAD)
       (set! error AP-ERROR-INVALID-PAYLOAD)
       (set! message "wire-integer-out-of-range"))
      ((>= receipt-index 0)
       (if (and (= (-> *ap-runtime* receipt-kind receipt-index) kind)
                (= (-> *ap-runtime* receipt-payload receipt-index) payload))
           (begin
             (set! result (-> *ap-runtime* receipt-result receipt-index))
             (set! error (-> *ap-runtime* receipt-error receipt-index))
             (set! message "duplicate-receipt"))
           (begin
             (set! error AP-ERROR-DUPLICATE-COMMAND-CONFLICT)
             (set! message "duplicate-command-conflict"))))
      ((or (< command-id 0)
           (<= command-id (-> *ap-runtime* command-high-watermark)))
       (set! error AP-ERROR-OUT-OF-ORDER-COMMAND-ID)
       (set! message "out-of-order-command-id"))
      ((= kind AP-COMMAND-TEST-ADDITIVE-EFFECT)
       (set! error AP-ERROR-ADDITIVE-EFFECT-FORBIDDEN)
       (set! message "additive-effect-forbidden")
       (ap3-record-receipt! command-id kind payload result error))
      ((!= kind AP-COMMAND-SET-TEST-TARGET)
       (set! error AP-ERROR-UNKNOWN-COMMAND)
       (set! message "unknown-command")
       (ap3-record-receipt! command-id kind payload result error))
      ((and (!= payload 0) (!= payload 1))
       (set! result AP-RESULT-INVALID-PAYLOAD)
       (set! error AP-ERROR-INVALID-PAYLOAD)
       (set! message "invalid-payload")
       (ap3-record-receipt! command-id kind payload result error))
      ((zero? (-> *ap-runtime* save-loaded))
       (set! result AP-RESULT-UNSAFE-NOW)
       (set! error AP-ERROR-SAVE-NOT-LOADED)
       (set! message "save-not-loaded")
       (ap3-record-receipt! command-id kind payload result error))
      ((zero? (-> *ap-runtime* ap-state-loaded))
       (set! result AP-RESULT-UNSAFE-NOW)
       (set! error AP-ERROR-AP-STATE-NOT-LOADED)
       (set! message "ap-state-not-loaded")
       (ap3-record-receipt! command-id kind payload result error))
      ((zero? (-> *ap-runtime* ap-state-bound))
       (set! result AP-RESULT-UNSAFE-NOW)
       (set! error AP-ERROR-AP-STATE-NOT-BOUND)
       (set! message "ap-state-not-bound")
       (ap3-record-receipt! command-id kind payload result error))
      ((zero? (-> *ap-runtime* safe-permanent))
       (set! result AP-RESULT-UNSAFE-NOW)
       (set! error AP-ERROR-UNSAFE-GAME-STATE)
       (set! message "unsafe-game-state")
       (ap3-record-receipt! command-id kind payload result error))
      ((= payload (-> *ap-runtime* test-target))
       (set! result AP-RESULT-ALREADY-APPLIED)
       (set! message "already-applied")
       (ap3-record-receipt! command-id kind payload result error))
      (else
       (set! (-> *ap-runtime* test-target) payload)
       (set! result AP-RESULT-APPLIED)
       (set! message "applied")
       (ap3-record-receipt! command-id kind payload result error)))
    (set! (-> *ap-runtime* last-command-result) result)
    (ap3-set-error! error message))
  (ap-export-state!)
  0)

(defun ap-client-disconnect! ((client-session string) (game-session string)
                              (sequence int) (client-status int))
  (set! (-> *ap-runtime* last-command-id) -1)
  (set! (-> *ap-runtime* last-command-kind) AP-COMMAND-DISCONNECT)
  (cond
    ((or (zero? (-> *ap-runtime* connection-ready))
         (not (string= client-session *ap3-client-session*)))
     (set! (-> *ap-runtime* last-command-result) AP-RESULT-FAILED)
     (ap3-set-error! AP-ERROR-INVALID-CLIENT-SESSION "invalid-client-session"))
    ((not (string= game-session *ap3-session-nonce*))
     (set! (-> *ap-runtime* last-command-result) AP-RESULT-FAILED)
     (ap3-set-error! AP-ERROR-INVALID-GAME-SESSION "invalid-game-session"))
    ((not (ap3-valid-client-status? client-status))
     (set! (-> *ap-runtime* last-command-result) AP-RESULT-INVALID-PAYLOAD)
     (ap3-set-error! AP-ERROR-INVALID-PAYLOAD "invalid-disconnect"))
    (else
     (set! (-> *ap-runtime* connection-ready) 0)
     (set! (-> *ap-runtime* client-status) client-status)
     (set! *ap3-last-client-contact-frame* -1)
     (ap3-copy-string! *ap3-proposed-save-identity* "-" 96)
     (set! (-> *ap-runtime* game-status) AP-GAME-STATUS-CLIENT-DISCONNECTED)
     (set! (-> *ap-runtime* last-command-result) AP-RESULT-OK)
     (ap3-clear-error!)))
  (ap-export-state!)
  0)

(defun ap3-install-native-hooks! ()
  (let* ((current-initialize
           (the-as (function game-info symbol game-save string resetter-spec game-info)
                   (method-of-type game-info initialize!)))
         (current-save
           (the-as (function game-info game-save string game-save)
                   (method-of-type game-info save-game)))
         (current-load
           (the-as (function game-info game-save game-save)
                   (method-of-type game-info load-game)))
         (done-state (method-of-type auto-save done))
         (error-state (method-of-type auto-save error))
         (current-done-code (-> done-state code))
         (current-error-code (-> error-state code)))
    (when (or (not *ap3-installed-game-info-initialize-wrapper*)
              (!= current-initialize *ap3-installed-game-info-initialize-wrapper*))
      (set! *ap3-native-game-info-initialize* current-initialize))
    (when (or (not *ap3-installed-save-wrapper*)
              (!= current-save *ap3-installed-save-wrapper*))
      (set! *ap3-native-save-game* current-save))
    (when (or (not *ap3-installed-load-wrapper*)
              (!= current-load *ap3-installed-load-wrapper*))
      (set! *ap3-native-load-game* current-load))
    (when (or (not *ap3-installed-auto-save-done-code*)
              (!= current-done-code *ap3-installed-auto-save-done-code*))
      (set! *ap3-native-auto-save-done-code* current-done-code))
    (when (or (not *ap3-installed-auto-save-error-code*)
              (!= current-error-code *ap3-installed-auto-save-error-code*))
      (set! *ap3-native-auto-save-error-code* current-error-code))
    (set! *ap3-installed-game-info-initialize-wrapper*
          ap3-game-info-initialize-wrapper)
    (set! *ap3-installed-save-wrapper* ap3-save-game-wrapper)
    (set! *ap3-installed-load-wrapper* ap3-load-game-wrapper)
    (set! *ap3-installed-auto-save-done-code* ap3-auto-save-done-code)
    (set! *ap3-installed-auto-save-error-code* ap3-auto-save-error-code)
    (method-set! game-info 9 ap3-game-info-initialize-wrapper)
    (method-set! game-info 22 ap3-save-game-wrapper)
    (method-set! game-info 23 ap3-load-game-wrapper)
    (set! (-> done-state code) ap3-auto-save-done-code)
    (set! (-> error-state code) ap3-auto-save-error-code))
  0)

(defun ap3-init! ()
  (+! *ap3-activation-generation* 1)
  (set! (-> *ap-runtime* connection-ready) 0)
  (set! (-> *ap-runtime* client-heartbeat) -1)
  (set! (-> *ap-runtime* client-status) AP-CLIENT-STATUS-STARTING)
  (set! (-> *ap-runtime* game-heartbeat) 0)
  (set! (-> *ap-runtime* game-status) AP-GAME-STATUS-SOURCE-LOADED)
  (if (and (nonzero? *ap3-reload-save-loaded*)
           (>= *ap3-reload-save-slot* 0)
           (< *ap3-reload-save-slot* 4)
           (ap3-valid-uuid-shape? *ap3-reload-save-identity*))
      (begin
        (set! (-> *ap-runtime* save-loaded) 1)
        (set! (-> *ap-runtime* native-save-slot) *ap3-reload-save-slot*)
        (set! (-> *ap-runtime* native-save-eligibility)
              *ap3-reload-save-eligibility*)
        (ap3-copy-string! *ap3-native-save-identity*
                          *ap3-reload-save-identity* 96))
      (begin
        (ap3-clear-reload-save-state!)
        (set! (-> *ap-runtime* save-loaded) 0)
        (set! (-> *ap-runtime* native-save-slot) -1)
        (set! (-> *ap-runtime* native-save-eligibility)
              AP-SAVE-ELIGIBILITY-UNKNOWN)
        (ap3-copy-string! *ap3-native-save-identity* "-" 96)))
  (set! (-> *ap-runtime* ap-state-loaded) 0)
  (set! (-> *ap-runtime* ap-state-bound) 0)
  (set! (-> *ap-runtime* current-level) (the-as symbol #f))
  (set! (-> *ap-runtime* test-target) 0)
  (set! (-> *ap-runtime* last-command-id) -1)
  (set! (-> *ap-runtime* command-high-watermark) -1)
  (set! (-> *ap-runtime* last-command-kind) AP-COMMAND-NONE)
  (set! (-> *ap-runtime* last-command-result) AP-RESULT-NONE)
  (set! (-> *ap-runtime* receipt-count) 0)
  (set! (-> *ap-runtime* receipt-next) 0)
  (set! (-> *ap-runtime* snapshot-revision) 0)
  (set! *ap3-last-client-contact-frame* -1)
  ;; Do not clear the reload-persistent native-operation candidate here. A
  ;; save/load wrapper may already have returned while its auto-save process is
  ;; still waiting for memory-card I/O; the newly installed done/error wrapper
  ;; must be able to finish that exact operation after this bridge reload.
  (ap3-copy-string! *ap3-client-session* "-" 96)
  (ap3-copy-string! *ap3-session-nonce* "-" 96)
  (ap3-copy-string! *ap3-proposed-save-identity* "-" 96)
  (ap3-copy-string! *ap3-consumed-save-identity* "-" 96)
  (ap3-clear-error!)
  (ap-export-state!)
  (ap3-log "[JAK3-AP] initialized protocol=~D integration=~D~%"
           AP-PROTOCOL-VERSION AP-GAME-INTEGRATION-VERSION)
  0)

(ap3-install-native-hooks!)
(ap3-init!)
