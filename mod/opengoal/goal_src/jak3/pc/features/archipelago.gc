;; Jak 3 Archipelago protocol-2 handshake bridge.
;; This milestone intentionally has no item, location, reward, save, or mission hooks.
(in-package goal)

(defconstant AP-PROTOCOL-VERSION 2)
(defconstant AP-GAME-INTEGRATION-VERSION 1)
(defconstant AP-SLOT-DATA-VERSION 1)
(defconstant AP-STATE-SCHEMA-VERSION 1)
(defconstant AP-ITEM-TABLE-VERSION 2)
(defconstant AP-LOCATION-TABLE-VERSION 2)
(defconstant AP-MISSION-TABLE-VERSION 1)
(defconstant AP-MISSION-PROFILE-VERSION 1)

;; Static compatibility metadata only. Milestone 4 does not add gameplay I/O.
(define *ap-design-version* (new 'global 'string 8 "0.3"))
(define *ap-item-table-hash*
  (new 'global 'string 65 "eb557676187512253327e2fdcbad2f8f49f62236d019fdd8129f14cb9987f99c"))
(define *ap-location-table-hash*
  (new 'global 'string 65 "f1c74c5a9da78e8e2b87a57ae283b514038be521699367342c0a555826333793"))
(define *ap-mission-table-hash*
  (new 'global 'string 65 "2e6e631ed650ceb860921e3feb066a85f6d858038a0f46f510a616d17633f09a"))

(defconstant AP-CLIENT-STATUS-STARTING 0)
(defconstant AP-CLIENT-STATUS-AP-DISCONNECTED 1)
(defconstant AP-CLIENT-STATUS-AP-CONNECTED 2)
(defconstant AP-CLIENT-STATUS-STOPPING 3)
(defconstant AP-CLIENT-STATUS-ERROR 4)

(defconstant AP-GAME-STATUS-SOURCE-LOADED 1)
(defconstant AP-GAME-STATUS-READY 2)
(defconstant AP-GAME-STATUS-PROTOCOL-MISMATCH 3)
(defconstant AP-GAME-STATUS-INTEGRATION-MISMATCH 4)
(defconstant AP-GAME-STATUS-CLIENT-DISCONNECTED 5)
(defconstant AP-GAME-STATUS-ERROR 6)

(defconstant AP-COMMAND-NONE 0)
(defconstant AP-COMMAND-HELLO 1)
(defconstant AP-COMMAND-PING 2)
(defconstant AP-COMMAND-DISCONNECT 3)

(defconstant AP-RESULT-NONE 0)
(defconstant AP-RESULT-OK 1)
(defconstant AP-RESULT-PONG 2)
(defconstant AP-RESULT-PROTOCOL-MISMATCH 3)
(defconstant AP-RESULT-INTEGRATION-MISMATCH 4)
(defconstant AP-RESULT-INVALID-SESSION 5)
(defconstant AP-RESULT-STALE-COMMAND 6)
(defconstant AP-RESULT-ERROR 7)

(deftype ap-state (basic)
  ((protocol-version int32)
   (game-integration-version int32)
   (connection-ready int32)
   (client-heartbeat int32)
   (client-status int32)
   (game-heartbeat int32)
   (game-status int32)
   (last-command int32)
   (last-command-sequence int32)
   (last-result int32)
   (snapshot-revision int32)
   (session-id string)
   (message string)))

(define *ap-state* (new 'global 'ap-state))
(define *ap-session-id* (new 'global 'string 97 "-"))
(define *ap-message* (new 'global 'string 128 "source-loaded"))
(define *ap-state-path* (new 'global 'string 512 "jak3-ap-state.tmp"))
(define *ap-log-path* (new 'global 'string 512 (the-as string #f)))
(define *ap-log-enabled* #f)
(define-extern ap-export-state! (function none))

(defmacro ap-log (control &rest args)
  ;; Debug-target output is not guaranteed to reach an nREPL client. Mirror
  ;; stable protocol events into the paired support log when it is configured.
  `(begin
     (format #t ,control ,@args)
     (when *ap-log-enabled*
       (let ((file (new 'stack 'file-stream *ap-log-path* 'append)))
         (format file ,control ,@args)
         (file-stream-close file)))))

(defun ap-copy-session-id! ((source string))
  (let ((src (-> source data))
        (dst (-> *ap-session-id* data))
        (count 0))
    (while (and (< count 96) (nonzero? (-> src 0)))
      (set! (-> dst 0) (-> src 0))
      (set! src (&-> src 1))
      (set! dst (&-> dst 1))
      (+! count 1))
    (set! (-> dst 0) (the-as uint 0)))
  0)

(defun ap-set-message! ((source string))
  (let ((src (-> source data))
        (dst (-> *ap-message* data))
        (count 0))
    (while (and (< count 127) (nonzero? (-> src 0)))
      (set! (-> dst 0) (-> src 0))
      (set! src (&-> src 1))
      (set! dst (&-> dst 1))
      (+! count 1))
    (set! (-> dst 0) (the-as uint 0)))
  0)

(defun ap-set-log-path! ((source string))
  (let ((src (-> source data))
        (dst (-> *ap-log-path* data))
        (count 0))
    (while (and (< count 511) (nonzero? (-> src 0)))
      (set! (-> dst 0) (-> src 0))
      (set! src (&-> src 1))
      (set! dst (&-> dst 1))
      (+! count 1))
    (set! (-> dst 0) (the-as uint 0)))
  (set! *ap-log-enabled* #t)
  (ap-log "[JAK3-AP] log-path configured protocol=~D integration=~D~%"
          AP-PROTOCOL-VERSION AP-GAME-INTEGRATION-VERSION)
  0)

(defun ap-set-state-path! ((source string))
  ;; The game and client normally have different working directories. The
  ;; client supplies one absolute path for this temporary observation channel.
  (let ((src (-> source data))
        (dst (-> *ap-state-path* data))
        (count 0))
    (while (and (< count 511) (nonzero? (-> src 0)))
      (set! (-> dst 0) (-> src 0))
      (set! src (&-> src 1))
      (set! dst (&-> dst 1))
      (+! count 1))
    (set! (-> dst 0) (the-as uint 0)))
  (ap-log "[JAK3-AP] state-path set to ~A~%" *ap-state-path*)
  (ap-export-state!)
  0)

(defun ap-valid-client-status? ((status int))
  (and (>= status AP-CLIENT-STATUS-STARTING)
       (<= status AP-CLIENT-STATUS-ERROR)))

(defun ap-export-state! ()
  ;; Matching begin/end revisions let the Python reader reject a snapshot read
  ;; while this direct file rewrite is incomplete.
  (+! (-> *ap-state* snapshot-revision) 1)
  (let ((file (new 'stack 'file-stream *ap-state-path* 'write))
        (revision (-> *ap-state* snapshot-revision)))
    (format file "snapshot_begin ~D~%" revision)
    (format file "protocol_version ~D~%" (-> *ap-state* protocol-version))
    (format file "game_integration_version ~D~%" (-> *ap-state* game-integration-version))
    (format file "connection_ready ~D~%" (-> *ap-state* connection-ready))
    (format file "session_id ~S~%" (-> *ap-state* session-id))
    (format file "client_heartbeat ~D~%" (-> *ap-state* client-heartbeat))
    (format file "client_status ~D~%" (-> *ap-state* client-status))
    (format file "game_heartbeat ~D~%" (-> *ap-state* game-heartbeat))
    (format file "game_status ~D~%" (-> *ap-state* game-status))
    (format file "last_command ~D~%" (-> *ap-state* last-command))
    (format file "last_command_sequence ~D~%" (-> *ap-state* last-command-sequence))
    (format file "last_result ~D~%" (-> *ap-state* last-result))
    (format file "message ~S~%" (-> *ap-state* message))
    (format file "snapshot_end ~D~%" revision)
    (file-stream-close file))
  (none))

(defun ap-init! ()
  (set! (-> *ap-state* protocol-version) AP-PROTOCOL-VERSION)
  (set! (-> *ap-state* game-integration-version) AP-GAME-INTEGRATION-VERSION)
  (set! (-> *ap-state* connection-ready) 0)
  (set! (-> *ap-state* client-heartbeat) -1)
  (set! (-> *ap-state* client-status) AP-CLIENT-STATUS-STARTING)
  (set! (-> *ap-state* game-heartbeat) 0)
  (set! (-> *ap-state* game-status) AP-GAME-STATUS-SOURCE-LOADED)
  (set! (-> *ap-state* last-command) AP-COMMAND-NONE)
  (set! (-> *ap-state* last-command-sequence) -1)
  (set! (-> *ap-state* last-result) AP-RESULT-NONE)
  (set! (-> *ap-state* snapshot-revision) 0)
  (set! (-> *ap-state* session-id) *ap-session-id*)
  (set! (-> *ap-state* message) *ap-message*)
  (ap-copy-session-id! "-")
  (ap-set-message! "source-loaded")
  (ap-export-state!)
  (ap-log "[JAK3-AP] initialized protocol=~D integration=~D~%"
          AP-PROTOCOL-VERSION AP-GAME-INTEGRATION-VERSION)
  0)

(defun ap-client-hello! ((protocol-version int)
                         (game-integration-version int)
                         (session-id string)
                         (client-status int))
  (set! (-> *ap-state* last-command) AP-COMMAND-HELLO)
  (set! (-> *ap-state* last-command-sequence) -1)
  (cond
    ((!= protocol-version AP-PROTOCOL-VERSION)
     (set! (-> *ap-state* connection-ready) 0)
     (set! (-> *ap-state* game-status) AP-GAME-STATUS-PROTOCOL-MISMATCH)
     (set! (-> *ap-state* last-result) AP-RESULT-PROTOCOL-MISMATCH)
     (ap-set-message! "protocol-mismatch"))
    ((!= game-integration-version AP-GAME-INTEGRATION-VERSION)
     (set! (-> *ap-state* connection-ready) 0)
     (set! (-> *ap-state* game-status) AP-GAME-STATUS-INTEGRATION-MISMATCH)
     (set! (-> *ap-state* last-result) AP-RESULT-INTEGRATION-MISMATCH)
     (ap-set-message! "integration-mismatch"))
    ((not (ap-valid-client-status? client-status))
     (set! (-> *ap-state* connection-ready) 0)
     (set! (-> *ap-state* game-status) AP-GAME-STATUS-ERROR)
     (set! (-> *ap-state* last-result) AP-RESULT-ERROR)
     (ap-set-message! "invalid-client-status"))
    (else
     (ap-copy-session-id! session-id)
     (set! (-> *ap-state* client-heartbeat) -1)
     (set! (-> *ap-state* client-status) client-status)
     (set! (-> *ap-state* game-heartbeat) 0)
     (set! (-> *ap-state* connection-ready) 1)
     (set! (-> *ap-state* game-status) AP-GAME-STATUS-READY)
     (set! (-> *ap-state* last-result) AP-RESULT-OK)
     (ap-set-message! "ready")))
  (ap-export-state!)
  (ap-log "[JAK3-AP] hello session=~A client-protocol=~D client-integration=~D ready=~D result=~D~%"
          session-id protocol-version game-integration-version
          (-> *ap-state* connection-ready) (-> *ap-state* last-result))
  0)

(defun ap-ping! ((session-id string) (sequence int) (client-status int))
  (cond
    ((or (zero? (-> *ap-state* connection-ready))
         (not (string= session-id (-> *ap-state* session-id))))
     (set! (-> *ap-state* last-command) AP-COMMAND-PING)
     (set! (-> *ap-state* last-command-sequence) sequence)
     (set! (-> *ap-state* last-result) AP-RESULT-INVALID-SESSION)
     (ap-set-message! "invalid-session")
     (ap-export-state!))
    ((not (ap-valid-client-status? client-status))
     (set! (-> *ap-state* last-command) AP-COMMAND-PING)
     (set! (-> *ap-state* last-command-sequence) sequence)
     (set! (-> *ap-state* last-result) AP-RESULT-ERROR)
     (ap-set-message! "invalid-client-status")
     (ap-export-state!))
    ((< sequence (-> *ap-state* client-heartbeat))
     (set! (-> *ap-state* last-command) AP-COMMAND-PING)
     (set! (-> *ap-state* last-command-sequence) sequence)
     (set! (-> *ap-state* last-result) AP-RESULT-STALE-COMMAND)
     (ap-set-message! "stale-command")
     (ap-export-state!))
    ((= sequence (-> *ap-state* client-heartbeat))
     ;; Re-export the same pong. Do not increment the logical heartbeat or
     ;; mutate gameplay state when the client retries a lost acknowledgement.
     (ap-export-state!)
     (ap-log "[JAK3-AP] duplicate ping session=~A sequence=~D pong=~D~%"
             session-id sequence (-> *ap-state* game-heartbeat)))
    (else
     (set! (-> *ap-state* client-heartbeat) sequence)
     (set! (-> *ap-state* client-status) client-status)
     (set! (-> *ap-state* game-heartbeat) (+ sequence 1))
     (set! (-> *ap-state* game-status) AP-GAME-STATUS-READY)
     (set! (-> *ap-state* last-command) AP-COMMAND-PING)
     (set! (-> *ap-state* last-command-sequence) sequence)
     (set! (-> *ap-state* last-result) AP-RESULT-PONG)
     (ap-set-message! "pong")
     (ap-export-state!)
     (ap-log "[JAK3-AP] ping session=~A sequence=~D pong=~D status=~D~%"
             session-id sequence (-> *ap-state* game-heartbeat) client-status)))
  0)

(defun ap-client-disconnect! ((session-id string) (sequence int) (client-status int))
  (if (string= session-id (-> *ap-state* session-id))
      (begin
        (set! (-> *ap-state* connection-ready) 0)
        (set! (-> *ap-state* client-status) client-status)
        (set! (-> *ap-state* game-status) AP-GAME-STATUS-CLIENT-DISCONNECTED)
        (set! (-> *ap-state* last-command) AP-COMMAND-DISCONNECT)
        (set! (-> *ap-state* last-command-sequence) sequence)
        (set! (-> *ap-state* last-result) AP-RESULT-OK)
        (ap-set-message! "client-disconnected"))
      (begin
        (set! (-> *ap-state* last-command) AP-COMMAND-DISCONNECT)
        (set! (-> *ap-state* last-command-sequence) sequence)
        (set! (-> *ap-state* last-result) AP-RESULT-INVALID-SESSION)
        (ap-set-message! "invalid-session")))
  (ap-export-state!)
  (ap-log "[JAK3-AP] disconnect session=~A sequence=~D result=~D~%"
          session-id sequence (-> *ap-state* last-result))
  0)

(ap-init!)
