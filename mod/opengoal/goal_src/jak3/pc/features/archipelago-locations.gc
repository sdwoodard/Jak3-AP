;; Jak 3 Archipelago finite location observation for Milestone 10.
(in-package goal)

(defconstant AP-LOCATION-TASK-10 743001010)
(defconstant AP-LOCATION-TASK-11 743001011)
(defconstant AP-LOCATION-TASK-12 743001012)
(defconstant AP-LOCATION-TASK-13 743001013)
(defconstant AP-LOCATION-TASK-14 743001014)
(defconstant AP-LOCATION-TASK-15 743001015)
(defconstant AP-LOCATION-TASK-16 743001016)
(defconstant AP-LOCATION-REWARD-ARMOR-1 743020036)

(defconstant AP-LOCATION-MASK-TASK-10 1)
(defconstant AP-LOCATION-MASK-TASK-11 2)
(defconstant AP-LOCATION-MASK-TASK-12 4)
(defconstant AP-LOCATION-MASK-TASK-13 8)
(defconstant AP-LOCATION-MASK-TASK-14 16)
(defconstant AP-LOCATION-MASK-TASK-15 32)
(defconstant AP-LOCATION-MASK-TASK-16 64)
(defconstant AP-LOCATION-MASK-REWARD-ARMOR-1 128)

(defconstant AP-LOCATION-SOURCE-NATIVE-TASK 0)
(defconstant AP-LOCATION-SOURCE-NATIVE-REWARD 1)
(defconstant AP-REWARD-NODE-ARMOR-1 36)

(deftype ap-location-observer-state (basic)
  ((descriptor-slot int32)
   (observed-mask int32)
   (pending-mask int32)
   (published-sequence int32 8)
   (published-generation int32 8)))

(define *ap-location-observer* (new 'global 'ap-location-observer-state))
(define *ap-location-descriptor-identity* (new 'global 'string 97 "-"))

(defun ap-locations-descriptor-ready? ()
  (and *game-info*
       (nonzero? (-> *ap-runtime* save-loaded))
       (nonzero? (-> *ap-runtime* ap-state-loaded))
       (nonzero? (-> *ap-runtime* ap-state-bound))
       (>= (-> *ap-runtime* native-save-slot) 0)
       (< (-> *ap-runtime* native-save-slot) 4)
       (not (string= *ap3-native-save-identity* "-"))))

(defun ap-locations-clear-descriptor! ()
  (set! (-> *ap-location-observer* descriptor-slot) -1)
  (set! (-> *ap-location-observer* observed-mask) 0)
  (set! (-> *ap-location-observer* pending-mask) 0)
  (dotimes (index 8)
    (set! (-> *ap-location-observer* published-sequence index) -1)
    (set! (-> *ap-location-observer* published-generation index) -1))
  (ap3-copy-string! *ap-location-descriptor-identity* "-" 96)
  0)

(defun ap-locations-refresh-descriptor! ()
  (if (ap-locations-descriptor-ready?)
      (when (or (!= (-> *ap-location-observer* descriptor-slot)
                     (-> *ap-runtime* native-save-slot))
                (not (string= *ap-location-descriptor-identity*
                              *ap3-native-save-identity*)))
        (ap-locations-clear-descriptor!)
        (set! (-> *ap-location-observer* descriptor-slot)
              (-> *ap-runtime* native-save-slot))
        (ap3-copy-string! *ap-location-descriptor-identity*
                          *ap3-native-save-identity* 96))
      (ap-locations-clear-descriptor!))
  0)

(defun ap-locations-queue-once! ((mask int))
  (when (not (logtest? (-> *ap-location-observer* observed-mask) mask))
    (logior! (-> *ap-location-observer* observed-mask) mask)
    (logior! (-> *ap-location-observer* pending-mask) mask))
  0)

(defun ap-locations-publish! ((index int) (mask int) (location-id int)
                              (task-id int) (source int) (native-node-id int))
  ;; Re-publish until Python has durably committed the local bit and outbox.
  (when (logtest? (-> *ap-location-observer* pending-mask) mask)
    (let ((sequence
            (ap-diagnostic-emit! AP-DIAG-EVENT-LOCATION-OBSERVED
                                 AP-DIAG-SEVERITY-INFO 3 location-id
                                 AP-RESULT-OK AP-ERROR-NONE
                                 task-id source native-node-id)))
      (when (>= sequence 0)
        (set! (-> *ap-location-observer* published-sequence index) sequence)
        (set! (-> *ap-location-observer* published-generation index)
              *ap-diagnostic-activation-generation*))))
  0)

(defun ap-locations-observe-reward! ((native-node-id int))
  ;; The reward wrapper provides the immediate observation. The persistent
  ;; node poll below is the restart/reload recovery path.
  (ap-locations-refresh-descriptor!)
  (when (and (ap-locations-descriptor-ready?)
             (= native-node-id AP-REWARD-NODE-ARMOR-1))
    (ap-locations-queue-once! AP-LOCATION-MASK-REWARD-ARMOR-1)
    (ap-locations-publish! 7 AP-LOCATION-MASK-REWARD-ARMOR-1
                           AP-LOCATION-REWARD-ARMOR-1 16
                           AP-LOCATION-SOURCE-NATIVE-REWARD
                           AP-REWARD-NODE-ARMOR-1))
  0)

(defun ap-locations-observe! ()
  (ap-locations-refresh-descriptor!)
  (when (ap-locations-descriptor-ready?)
    ;; task-complete? and task-node-closed? read save-persistent native state.
    (when (task-complete? *game-info* (game-task arena-training-1))
      (ap-locations-queue-once! AP-LOCATION-MASK-TASK-10))
    (when (task-complete? *game-info* (game-task arena-fight-1))
      (ap-locations-queue-once! AP-LOCATION-MASK-TASK-11))
    (when (task-complete? *game-info* (game-task wascity-chase))
      (ap-locations-queue-once! AP-LOCATION-MASK-TASK-12))
    (when (task-complete? *game-info* (game-task wascity-pre-game))
      (ap-locations-queue-once! AP-LOCATION-MASK-TASK-13))
    (when (task-complete? *game-info* (game-task desert-turtle-training))
      (ap-locations-queue-once! AP-LOCATION-MASK-TASK-14))
    (when (task-complete? *game-info* (game-task desert-course-race))
      (ap-locations-queue-once! AP-LOCATION-MASK-TASK-15))
    (when (task-complete? *game-info* (game-task desert-artifact-race-1))
      (ap-locations-queue-once! AP-LOCATION-MASK-TASK-16))
    (when (and (task-node-closed?
                 (game-task-node desert-artifact-race-1-resolution))
               (*ap3-reward-location-recovery-eligible-hook*
                 AP-REWARD-NODE-ARMOR-1))
      (ap-locations-queue-once! AP-LOCATION-MASK-REWARD-ARMOR-1))

    (ap-locations-publish! 0 AP-LOCATION-MASK-TASK-10
                           AP-LOCATION-TASK-10 10
                           AP-LOCATION-SOURCE-NATIVE-TASK 0)
    (ap-locations-publish! 1 AP-LOCATION-MASK-TASK-11
                           AP-LOCATION-TASK-11 11
                           AP-LOCATION-SOURCE-NATIVE-TASK 0)
    (ap-locations-publish! 2 AP-LOCATION-MASK-TASK-12
                           AP-LOCATION-TASK-12 12
                           AP-LOCATION-SOURCE-NATIVE-TASK 0)
    (ap-locations-publish! 3 AP-LOCATION-MASK-TASK-13
                           AP-LOCATION-TASK-13 13
                           AP-LOCATION-SOURCE-NATIVE-TASK 0)
    (ap-locations-publish! 4 AP-LOCATION-MASK-TASK-14
                           AP-LOCATION-TASK-14 14
                           AP-LOCATION-SOURCE-NATIVE-TASK 0)
    (ap-locations-publish! 5 AP-LOCATION-MASK-TASK-15
                           AP-LOCATION-TASK-15 15
                           AP-LOCATION-SOURCE-NATIVE-TASK 0)
    (ap-locations-publish! 6 AP-LOCATION-MASK-TASK-16
                           AP-LOCATION-TASK-16 16
                           AP-LOCATION-SOURCE-NATIVE-TASK 0)
    (ap-locations-publish! 7 AP-LOCATION-MASK-REWARD-ARMOR-1
                           AP-LOCATION-REWARD-ARMOR-1 16
                           AP-LOCATION-SOURCE-NATIVE-REWARD
                           AP-REWARD-NODE-ARMOR-1))
  0)

(defun ap-locations-ack-one! ((index int) (mask int)
                              (activation-generation int)
                              (source-sequence int))
  (when (and (= activation-generation
                (-> *ap-location-observer* published-generation index))
             (>= (-> *ap-location-observer* published-sequence index) 0)
             (<= (-> *ap-location-observer* published-sequence index)
                 source-sequence))
    (logclear! (-> *ap-location-observer* pending-mask) mask))
  0)

(defun ap-locations-ack! ((activation-generation int) (source-sequence int))
  ;; This only acknowledges the GOAL-to-Python diagnostic drain. AP server
  ;; confirmation remains a separate Connected/RoomUpdate reconciliation.
  (ap-locations-ack-one! 0 AP-LOCATION-MASK-TASK-10
                         activation-generation source-sequence)
  (ap-locations-ack-one! 1 AP-LOCATION-MASK-TASK-11
                         activation-generation source-sequence)
  (ap-locations-ack-one! 2 AP-LOCATION-MASK-TASK-12
                         activation-generation source-sequence)
  (ap-locations-ack-one! 3 AP-LOCATION-MASK-TASK-13
                         activation-generation source-sequence)
  (ap-locations-ack-one! 4 AP-LOCATION-MASK-TASK-14
                         activation-generation source-sequence)
  (ap-locations-ack-one! 5 AP-LOCATION-MASK-TASK-15
                         activation-generation source-sequence)
  (ap-locations-ack-one! 6 AP-LOCATION-MASK-TASK-16
                         activation-generation source-sequence)
  (ap-locations-ack-one! 7 AP-LOCATION-MASK-REWARD-ARMOR-1
                         activation-generation source-sequence)
  source-sequence)

(ap-locations-clear-descriptor!)
(set! *ap3-locations-observe-hook* ap-locations-observe!)
(set! *ap3-locations-ack-hook* ap-locations-ack!)
(set! *ap3-reward-location-observe-hook* ap-locations-observe-reward!)
(set! *ap3-locations-module-active* 1)
(ap-export-state!)
(format #t "[JAK3-AP] locations initialized tasks=10-16 reward-node=36~%")
